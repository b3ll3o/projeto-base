{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/pretooluse-block-pnpm-lock.mjs\"; if [ -f \"$f\" ]; then node \"$f\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$PWD}/.agents/hooks/posttooluse-stack-review.sh\"; if [ -f \"$f\" ]; then bash \"$f\"; fi",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
