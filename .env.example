# ============================================================================
# OpenTelemetry (MVP — Phase 5 / Task 5.3)
# ============================================================================
# Service identification (cada app sobrescreve via apps/<app>/.env.example).
# Valor padrão alinhado com plano §3.1: SERVICE_NAME=projeto-base-api
# (apps/api sobrescreve para o mesmo valor; apps/web sobrescreve para
# `projeto-base-web`).
OTEL_SERVICE_NAME=projeto-base-api
OTEL_SERVICE_VERSION=0.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
# Sampling (1.0 = tudo em dev; em prod começar com 0.1 e ajustar).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Resource attributes extras (deployment, namespace, etc.).
OTEL_RESOURCE_ATTRIBUTES=service.namespace=projeto-base,deployment.environment=development
# Habilita SDK por padrão (apps individuais podem setar `true` para desligar).
OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT: apps/api/src/.../tracing.ts e
# apps/web/instrumentation.node.ts criam explicitamente OTLPTraceExporter
# (HTTP, não gRPC). Quando o collector está rodando sob profile
# `observability`, o DNS interno do Compose resolve `otel-collector` na
# porta OTLP HTTP (4318 + path /v1/traces).
# Em dev local sem collector, deixe vazio para desabilitar export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces