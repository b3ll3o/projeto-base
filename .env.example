# ============================================================================
# OpenTelemetry (MVP — Phase 5 / Task 5.3)
# ============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT: shared by api and web (compose-side collector URL)
# Quando o collector está rodando sob profile `observability`, o DNS interno
# do Compose resolve `otel-collector` na porta OTLP gRPC (4317).
# Em dev local sem collector, deixe vazio para desabilitar export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Service identification (também pode ser sobrescrito por env de cada app).
OTEL_SERVICE_NAME=projeto-base
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
# Sampling (1.0 = tudo; em prod começar com 0.1 e ajustar).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# Resource attributes extras (comma-separated key=value pairs).
OTEL_RESOURCE_ATTRIBUTES=service.namespace=projeto-base,deployment.environment=development
