# .env.production.example
# Template para .env.production (NÃO versionar o .env.production real).
# Copie este arquivo, preencha os CHANGE_ME_* e adicione em .gitignore local.

# #68: senha do Postgres (NUNCA plaintext em compose, NUNCA commitada)
POSTGRES_USER=projeto
POSTGRES_PASSWORD=CHANGE_ME_strong_password_min_16_chars
POSTGRES_DB=projeto_base

# #68: connection string completa da API para o Postgres.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://projeto:CHANGE_ME_strong_password_min_16_chars@postgres:5432/projeto_base?schema=public

# #73: origens permitidas para CORS (separadas por vírgula). Devem incluir
# a URL pública do front em produção (ex: https://app.exemplo.com).
ALLOWED_ORIGINS=https://app.exemplo.com,https://www.exemplo.com

# #72: rate limit por IP (default no main.ts: 100 req/min)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

# Web
API_BASE_URL=https://api.exemplo.com/api/v1

# Logging
LOG_LEVEL=info
