  "cards": [
    {
      "dot": "emerald",
      "title": "Caminho feliz — INSERT + audit cascade",
      "items": [
        "expectedVersion=0 (criação inicial) garante que outro writer não sobrescreve",
        "AuditContextStore.run() propaga W3C traceId do OTel span ativo",
        "UserCreatedEvent → mapEventNameToOperation() → INSERT em users_history"
      ]
    },
    {
      "dot": "cyan",
      "title": "Defesa em profundidade",
      "items": [
        "ZodValidationPipe no boundary HTTP (400 cedo com mensagem útil)",
        "ApplicationValidationException dentro do use case (defesa secundária)",
        "GlobalExceptionFilter converte tudo em RFC 7807 problem+json"
      ]
    },
    {
      "dot": "rose",
      "title": "Email duplicado — 409",
      "items": [
        "findByEmail() pré-check antes de User.criar() — evita lock contention",
        "ApplicationEmailAlreadyInUseException mapeia para 409 (conflict)",
        "Email uniqueness também é validação do VO Email.create (formato)"
      ]
    }
