  "cards": [
    {
      "dot": "emerald",
      "title": "Caminho 200 OK",
      "items": [
        "PrismaService.$queryRawUnsafe('SELECT 1') valida o pool de conexões",
        "Payload mínimo { status, checks.database } é contrato do HEALTHCHECK",
        "Latência típica < 50ms — adequado para docker HEALTHCHECK interval=10s"
      ]
    },
    {
      "dot": "rose",
      "title": "Caminho 503 Degradado",
      "items": [
        "ServiceUnavailableException lançada pelo controller é mapeada via GlobalExceptionFilter",
        "Resposta segue RFC 7807 (application/problem+json)",
        "Docker HEALTHCHECK trata 503 como unhealthy → restart policy age"
      ]
    },
    {
      "dot": "cyan",
      "title": "Atores + Boundary",
      "items": [
        "FastifyAdapter recebe o request antes do NestJS pipeline",
        "PrismaService é o único port para PostgreSQL — não há SQL fora deste boundary",
        "Versão /v1 é obrigatória pelo FastifyAdapter (sem version: '1' → 500)"
      ]
    }
  ]
