  "cards": [
    {
      "dot": "emerald",
      "title": "Audit history semantics",
      "items": [
        "history é read-only — sem If-Match, sem idempotência",
        "AuditContext não é necessário (listagem é passiva)",
        "Cursor pagination igual ao GET /users (mesma port de encoder)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cross-BC reuse",
      "items": [
        "AuditServicePort é compartilhado com outros BCs (audit é infra shared)",
        "users_history é uma tabela genérica (entityName+entityId columns)",
        "Sem soft-delete filter — histórico inclui eventos de users deletados"
      ]
    },
    {
      "dot": "orange",
      "title": "Performance",
      "items": [
        "Index composto (entityName, entityId, version DESC) — query eficiente",
        "Sem N+1 — único SELECT retorna page inteira",
        "OpenAPI documenta cursor + limit query params"
      ]
    }
