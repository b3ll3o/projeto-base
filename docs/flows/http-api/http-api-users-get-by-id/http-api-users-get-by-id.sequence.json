  "cards": [
    {
      "dot": "emerald",
      "title": "Soft-delete semantics",
      "items": [
        "findById filtra deletedAt IS NULL por default — sem flag → 404 illusion",
        "findById com includeDeleted=true retorna o user (usado por restore flow)",
        "Comportamento documentado em prisma-user.repository.ts:103-112"
      ]
    },
    {
      "dot": "rose",
      "title": "404 vs soft-deleted",
      "items": [
        "Soft-deleted vira 404 (não 410 Gone) — Uniformidade com 'não existe'",
        "Traders 401/403 não se aplicam (auth será Fase 8 com JWT)",
        "RFC 7807 problem+json indica resourceName=User, resourceId=id"
      ]
    },
    {
      "dot": "cyan",
      "title": "Layered architecture",
      "items": [
        "Controller fino — só parse + delegação (sem regra de negócio)",
        "Use case valida VO via UserId.create() (defesa secundária)",
        "PrismaUserRepo encapsula SQL (camada infrastructure)"
      ]
    }
