  "cards": [
    {
      "dot": "emerald",
      "title": "Mapper é função PURA",
      "items": [
        "Não lança, não loga, não instancia — recebe Error, devolve {status,code,title}",
        "instanceof checks ordem: DOMAIN primeiro, depois APPLICATION (defensivo)",
        "Default 500 INTERNAL_SERVER_ERROR cobre qualquer Error não-mapeado"
      ]
    },
    {
      "dot": "cyan",
      "title": "RFC 7807 ProblemDetails",
      "items": [
        "type / title / status / detail / instance / code / traceId",
        "traceId = W3C OTel span id ativo (correlaciona erro com trace)",
        "Cliente (apps/web) trata ProblemDetails uniformemente via codigo"
      ]
    },
    {
      "dot": "rose",
      "title": "Por que domain vs application?",
      "items": [
        "Domain exceptions vivem em domain/ (puro, sem NestJS)",
        "Application exceptions vivem em application/ (boundary inbound)",
        "Use cases SEMPRE traduzem domain → application (translateDomainException)"
      ]
    }
