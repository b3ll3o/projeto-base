  "cards": [
    {
      "dot": "emerald",
      "title": "Soft-delete semantics",
      "items": [
        "DELETE não remove o row — apenas seta deletedAt = NOW() (preserva histórico)",
        "204 No Content (controller @HttpCode(204)) — sem ETag/ETag='W/v(final)'",
        "findById subsequente retorna null (filtra deletedAt IS NULL)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Audit cascade (DELETE + archive)",
      "items": [
        "audit.record(DELETE) insere em users_history (audit trail)",
        "audit.archive() insere snapshot completo em users_archive (restore path)",
        "extrai previousVersion + reason do UserDeletedEvent"
      ]
    },
    {
      "dot": "rose",
      "title": "Optimistic locking obrigatório",
      "items": [
        "412 se If-Match divergente (sem If-Match = 400 IF_MATCH_REQUIRED)",
        "404 se User já soft-deletado (findById filtra deletedAt)",
        "PATCH/DELETE subsequentes exigem ETag atualizado — força cliente a recarregar"
      ]
    }
  ]
