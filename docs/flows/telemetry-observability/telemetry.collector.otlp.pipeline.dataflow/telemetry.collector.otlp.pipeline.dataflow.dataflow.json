  "cards": [
    {
      "dot": "emerald",
      "title": "OpenTelemetry Collector",
      "items": [
        "Componente agnostico entre apps e backends",
        "Configuravel via YAML: receivers/processors/exporters",
        "Corre em infra/otelcol (Docker compose local)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Receivers OTLP",
      "items": [
        "gRPC :4317 (server-side, alta performance)",
        "HTTP :4318 (browser-friendly)",
        "Ambos aceitam traces+metrics+logs"
      ]
    },
    {
      "dot": "orange",
      "title": "Processors",
      "items": [
        "batch: agregacao 1-10s antes de export",
        "memory_limiter: protege contra OOM",
        "tail_sampling: 100% erros, 10% outros"
      ]
    },
    {
      "dot": "rose",
      "title": "Backends (long-term)",
      "items": [
        "Tempo: traces com traceId W3C",
        "Prometheus: metrics scraping",
        "Loki: logs estruturados (futuro)"
      ]
    }
  ]
