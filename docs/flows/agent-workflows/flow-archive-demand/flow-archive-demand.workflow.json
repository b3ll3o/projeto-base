    {
      "dot": "cyan",
      "title": "Gates de Saída",
      "items": [
        "gh pr view <N> --json state retorna MERGED",
        "b<N>-result.md existe em .claude/projects/.../memory/",
        "improvements tem ≥1 categoria não-zero",
        "archive:lint valida 8 campos canônicos do frontmatter",
        "Commit message segue convenção docs(agents): archive demand <slug>"
      ]
    },
    {
      "dot": "amber",
      "title": "Quando NÃO usar",
      "items": [
        "Demanda ainda em progresso (mesmo pausada)",
        "Demanda sem b<N>-result.md (sem elegibilidade)",
        "Bug trivial sem melhorias estruturais (não há demanda)",
        "Demanda abandonada — usar cancelled/<slug>.md em vez de archive/"
      ]
    }
