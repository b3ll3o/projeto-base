    "quality_profile": "standard",
    "output": "flow-specialist-routing.workflow.html",
    "views": [
      {
        "id": "happy-path",
        "label": "Demanda coberta",
        "focus": ["specialist_router", "specialist_1", "specialist_2", "controller"],
        "note": "specialists_dispatched ≥ 1 → controller prossegue com writing-plans."
      },
      {
        "id": "gap-blocker",
        "label": "Gap detectado",
        "focus": ["specialist_router", "controller", "agent_architect"],
        "note": "gap_detected → controller BLOQUEIA planning; agent-architect cria specialist."
      }
    ],
    "tier": "critical",
    "mechanism": "auto",
    "subject": "specialist-routing — Orquestrador de Demanda Pré-Planning"
  },
  "lanes": [
    {
      "id": "controller",
      "label": "Controller (humano)"
    },
    {
      "id": "router",
      "label": "Specialist Router"
    },
    {
      "id": "specialists",
      "label": "Specialists Paralelos"
    },
    {
      "id": "policy",
      "label": "Policy / Recovery",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "classify",
      "label": "Classifica",
      "fromCol": 0,
      "toCol": 1,
      "variant": "emphasis"
    },
    {
      "id": "dispatch",
      "label": "Despacha paralelo",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "decide",
      "label": "Decide",
      "fromCol": 3,
      "toCol": 3,
      "variant": "dashed"
    }
  ],
  "groups": [
    {
      "id": "router_lane",
      "label": "Router",
      "lane": "router",
      "fromCol": 0,
      "toCol": 1,
      "variant": "emphasis"
    },
    {
      "id": "fanout",
      "label": "Fan-out paralelo",
      "lane": "specialists",
      "fromCol": 2,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "exception_path",
      "label": "Exception path",
      "lane": "policy",
      "fromCol": 2,
      "toCol": 3,
      "variant": "security"
    }
