{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Specialist Routing — Orquestrador Pré-Planning",
    "subtitle": "Router classifica demanda → specialists paralelos → controller decide",
    "animation": "trace",
