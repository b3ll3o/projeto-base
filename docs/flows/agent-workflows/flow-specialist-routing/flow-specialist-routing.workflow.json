    },
    {
      "id": "specialist_1",
      "lane": "specialists",
      "col": 1,
      "type": "backend",
      "label": "specialist [1]",
      "sublabel": "ex: nestjs-specialist",
      "tag": "domain match",
      "width": 160
    },
    {
      "id": "specialist_2",
      "lane": "specialists",
      "col": 2,
      "type": "frontend",
      "label": "specialist [2]",
      "sublabel": "ex: nextjs-specialist",
      "tag": "domain match",
      "width": 160
    },
    {
      "id": "controller",
      "lane": "controller",
      "col": 3,
      "type": "security",
      "label": "controller",
      "sublabel": "planejar | bloquear",
      "tag": "writing-plans input",
      "width": 160
    },
    {
      "id": "agent_architect",
      "lane": "policy",
      "col": 3,
      "type": "security",
      "label": "agent-architect",
      "sublabel": "criar specialist novo",
      "tag": "se gap_detected",
      "width": 160
    }
  ],
  "edges": [
    {
      "id": "router-to-spec-1",
      "from": "specialist_router",
      "to": "specialist_1",
      "label": "dispatch",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "router-to-spec-2",
      "from": "specialist_router",
      "to": "specialist_2",
      "label": "dispatch",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "spec-1-to-controller",
      "from": "specialist_1",
      "to": "controller",
      "label": "plans_aggregated",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "spec-2-to-controller",
      "from": "specialist_2",
      "to": "controller",
      "label": "plans_aggregated",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "controller-gap-architect",
      "from": "controller",
      "to": "agent_architect",
      "label": "gap_detected?",
      "variant": "security",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Outputs Esperados",
      "items": [
        "classification { paths, keywords, scope }",
        "specialists_dispatched[] ≥ 1",
        "gap_detected boolean + suggested_specialist"
      ]
    },
    {
      "dot": "rose",
      "title": "Bloqueios",
      "items": [
        "Planejar com gap_detected=true (viola evolucao-agents)",
        "Dispatchar implementer antes do router",
        "Modificar matriz fora de PR"
      ]
    },
    {
      "dot": "emerald",
      "title": "Critérios de Done",
      "items": [
        "Output YAML em .agents/runs/<ts>-specialist-<n>.yaml",
        "classification tem ≥1 signal (path/keyword/scope)",
        "plans_aggregated integrado com writing-plans"
      ]
    }
  ]
