  "mainPath": ["specialist_router", "specialist_1", "controller"],
  "nodes": [
    {
      "id": "specialist_router",
      "lane": "router",
      "col": 0,
      "type": "backend",
      "label": "specialist-router",
      "sublabel": "matriz canônica",
      "tag": "PATH_GLOBS + KEYWORDS + SCOPES",
