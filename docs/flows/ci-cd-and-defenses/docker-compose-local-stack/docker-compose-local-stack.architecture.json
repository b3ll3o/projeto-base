  "cards": [
    {
      "dot": "emerald",
      "title": "Stack Local (docker-compose.yml)",
      "items": [
        "4 services: postgres + api + web + otel-collector",
        "depends_on healthcheck-based (start_order garantido)",
        "otel-collector usa profile 'observability' (não inicia por default)",
        "Override dev em docker-compose.dev.yml (volumes + hot reload)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Healthchecks (defense-in-depth)",
      "items": [
        "postgres: pg_isready -U projeto (5s interval)",
        "api: curl /api/v1/health (10s interval, 20s start_period)",
        "web: node check /api/health (10s interval, 20s start_period)",
        "depends_on com condition: service_healthy bloqueia start até OK"
      ]
    },
    {
      "dot": "amber",
      "title": "Observability Profile",
      "items": [
        "Inicia com: docker compose --profile observability up",
        "otel-collector recebe OTLP gRPC (4317) e HTTP (4318)",
        "Config em infra/otelcol/config.yaml (read-only mount)",
        "Telemetria: backend NodeSDK + browser SDK enviam para collector"
      ]
    }
  ]
}
