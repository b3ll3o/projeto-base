      "to": "block",
      "label": "ok=false",
      "variant": "security",
      "role": "branch"
    },
    {
      "id": "ok-to-ci",
      "from": "push_ok",
      "to": "remote_ci",
      "label": "refs visíveis",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "block-halt",
