      }
    ]
  },
  "lanes": [{ "id": "dev", "label": "Dev (local)" }],
  "phases": [
    { "id": "trigger", "label": "Trigger", "fromCol": 0, "toCol": 0, "variant": "default" },
    { "id": "checks", "label": "Drift checks", "fromCol": 1, "toCol": 1, "variant": "emphasis" },
    { "id": "gate", "label": "Gate", "fromCol": 2, "toCol": 3, "variant": "security" }
