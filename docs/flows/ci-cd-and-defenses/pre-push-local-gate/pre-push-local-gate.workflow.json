      "width": 170,
      "yOffset": 130
    },
    {
      "id": "remote_ci",
      "lane": "dev",
      "col": 3,
      "type": "external",
      "label": "CI remoto",
      "sublabel": "origin",
      "tag": "github.com",
      "width": 150
    }
