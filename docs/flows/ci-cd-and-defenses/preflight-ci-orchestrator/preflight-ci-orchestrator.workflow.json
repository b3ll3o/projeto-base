    },
    {
      "dot": "cyan",
      "title": "Check taxonomy",
      "items": [
        "doc-refs: paths relativos quebrados em docs/*.md",
        "tsconfig-drift: extends divergentes entre tsconfigs",
        "eslint-drift: regras duplicadas/legadas",
        "turbo-drift: $schema ausente, nomes invalidos"
      ]
    },
    {
      "dot": "orange",
      "title": "Sequencial com fallback",
      "items": [
        "Cada check emite CheckResult {ok, drift, duration}",
        "Falha aborta script com exit 1",
        "Output guardado em .tooling/.preflight-state.json"
      ]
    },
    {
      "dot": "rose",
      "title": "Gatilhos",
      "items": [
        ".husky/pre-push (camada 1) — local <10s",
        ".github/workflows/ci.yml job preflight (camada 2) — ~10s",
        "Ambos rodam o MESMO script (idempotente)"
      ]
    }
  ]
