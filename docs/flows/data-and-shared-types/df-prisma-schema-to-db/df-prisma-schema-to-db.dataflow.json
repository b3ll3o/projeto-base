  "cards": [
    {
      "dot": "emerald",
      "title": "Pipeline monorepo",
      "items": [
        "turbo.json: prisma.generate → db:apply como deps",
        "generate roda no turbo build de apps/api (gera node_modules/.prisma/client)",
        "migrate dev roda via Docker local (postgres:16-alpine)",
        "CI: prisma generate em build, migrate deploy em release"
      ]
    },
    {
      "dot": "cyan",
      "title": "Migration content exemplo",
      "items": [
        "CREATE TYPE audit_operation AS ENUM (INSERT, UPDATE, DELETE, RESTORE)",
        "CREATE TABLE users (id UUID PK, email UNIQUE, version Int)",
        "CREATE INDEX users_email_idx, users_deleted_at_idx, users_created_at_idx",
        "users_history: unique (entity_id, version) + index (entity_id, changed_at DESC)",
        "users_archive: UNIQUE entity_id + index deleted_at DESC"
      ]
    },
    {
      "dot": "amber",
      "title": "Idempotência + drift detection",
      "items": [
        "migration_lock.toml com provider=postgresql",
        "_prisma_migrations table registra applied migrations",
        "prisma migrate dev detecta drift e oferece reset (dev only)",
        "prisma migrate deploy idempotente em CI/CD (production)"
      ]
    }
  ]
