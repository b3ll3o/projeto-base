#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Rodar lint-staged SOMENTE se houver arquivos staged que casem com os globs.
# Sem isso, commits com só .gitkeep/.md/.png falham o hook.
staged_lint=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|json|yaml|yml)$' || true)
if [ -n "$staged_lint" ]; then
  pnpm exec lint-staged || exit 1
else
  echo "skip lint-staged (no staged files matching globs)"
fi

# Rodar stack-code-reviewer + doc-sync em arquivos .ts/.tsx/.prisma (Phase 8 scripts)
# || true protege contra sh -e (husky wrapper) abortando em commits sem .ts/.tsx/.prisma
changed_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|prisma)$' || true)
if [ -n "$changed_files" ]; then
  if [ -f tooling/scripts/stack-code-reviewer.ts ]; then
    echo "stack-code-reviewer..."
    pnpm tsx tooling/scripts/stack-code-reviewer.ts --files="$changed_files" --mode=pre-commit || exit 1
  else
    echo "skip stack-code-reviewer (tooling/scripts/ not yet ready — Phase 8)"
  fi
  if [ -f tooling/scripts/doc-sync.ts ]; then
    echo "doc-sync..."
    pnpm tsx tooling/scripts/doc-sync.ts --files="$changed_files" --mode=incremental --auto-apply-minor=true || exit 1
  else
    echo "skip doc-sync (tooling/scripts/ not yet ready — Phase 8)"
  fi
fi

# Defesa: se algum comando futuro invocar `husky <arg>` por engano, repara core.hooksPath.
# Idempotente; custo ~50ms.
pnpm exec husky >/dev/null 2>&1 || true
