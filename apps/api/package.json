{
  "name": "@projeto/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@projeto/eslint-config": "workspace:*",
    "@projeto/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-fastify": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.2",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.54.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/client": "^6.19.3",
    "@projeto/shared-types": "workspace:*",
    "argon2": "^0.45.2",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.4.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  }
}
