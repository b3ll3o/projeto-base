{
  "name": "@projeto/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "echo 'apps/api lint stub (real wiring in Phase 3)' && exit 0",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "echo 'apps/api test stub (real wiring in Phase 3)' && exit 0",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@projeto/eslint-config": "workspace:*",
    "@projeto/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^10.13.0",
    "@types/express": "^5.0.0",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.12.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "@projeto/shared-types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  }
}
