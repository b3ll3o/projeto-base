# apps/api/.env.example
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://projeto:projeto@localhost:5432/projeto_base?schema=public
LOG_LEVEL=info
# ============================================================================
# OpenTelemetry — Backend (apps/api)
# ============================================================================
# Sobrescreve o endpoint compartilhado do .env raiz se necessário.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Sinalização: traces ON, metrics ON (logs OFF — Pino é o logger canônico).
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
# SDK Node usa gRPC por padrão (porta 4317); HTTP seria 4318.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Identificação do serviço (recomendado por app).
OTEL_SERVICE_NAME=projeto-base-api
