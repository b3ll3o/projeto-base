generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // pt-BR (Fase 9 — RLS): DUAS conexões, e a separação é o ponto.
  //
  // `url` é a da APLICAÇÃO: o papel `app_runtime`, NOSUPERUSER NOBYPASSRLS.
  // É ela que faz as policies valerem — se o app conectasse como dono, o
  // isolamento existiria só no papel e o RLS seria decoração.
  //
  // `directUrl` é a do DONO, e é a que o CLI do Prisma usa (`migrate`,
  // `db seed`). A migration precisa dela: `CREATE ROLE`, `ALTER TABLE ...
  // ENABLE ROW LEVEL SECURITY` e `GRANT` exigem o dono da tabela, e um papel
  // sem BYPASSRLS não pode aplicá-las.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum AuditOperation {
  INSERT
  UPDATE
  DELETE
  RESTORE

  @@map("audit_operation")
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique
  name         String
  // Hash argon2id da senha. NUNCA sai para fora: nem `UserOutputDto`, nem
  // os snapshots JSONB de `users_history`/`users_archive`.
  passwordHash String    @map("password_hash")
  // ProfileId: FK para Profile. Nullable para soft-rollout: a migration
  // adiciona a coluna como null e o seed atribui 'viewer' como default.
  // pt-BR (#93.1 — RBAC, 2026-10-16): o JwtAuthGuard consulta
  // `users.profile_id` em cada request via cache de 5s, então o caminho
  // `null` é tratado como "sem perfil" = 0 permissões (deny-by-default).
  // O cascade (onDelete: Restrict) impede deletar um Profile que tem Users
  // atribuídos — o admin precisa reatribuir antes.
  profileId    String?   @map("profile_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by") @db.Uuid
  version      Int       @default(1)

  // Relação: um User pertence a 0..1 Profile. Nullable para rollback /
  // usuários legados sem profile. onDelete: Restrict porque o admin precisa
  // reatribuir antes de deletar o Profile.
  profile     Profile?           @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // D4: um User pode estar em N empresas. `users.profile_id` continua valendo
  // (a Fase 4 troca só o caminho de leitura), mas o perfil efetivo passa a ser
  // o do tenant — ver `multi-tenant-specialist` Passo 4.
  memberships TenantMembership[]

  @@index([email])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@index([profileId])
  @@map("users")
}

model UserHistory {
  id              String         @id @default(uuid()) @db.Uuid
  entityId        String         @map("entity_id") @db.Uuid
  version         Int            @map("version")
  previousVersion Int?           @map("previous_version")
  operation       AuditOperation @map("operation")
  snapshot        Json           @map("snapshot")
  changedAt       DateTime       @default(now()) @map("changed_at")
  changedBy       String?        @map("changed_by") @db.Uuid
  reason          String?        @map("reason")

  @@unique([entityId, version])
  @@index([entityId, changedAt(sort: Desc)])
  @@map("users_history")
}

model UserArchive {
  id        String   @id @default(uuid()) @db.Uuid
  entityId  String   @unique @map("entity_id") @db.Uuid
  version   Int      @map("version")
  snapshot  Json     @map("snapshot")
  deletedAt DateTime @default(now()) @map("deleted_at")
  deletedBy String?  @map("deleted_by") @db.Uuid
  reason    String?  @map("reason")

  @@index([deletedAt(sort: Desc)])
  @@map("users_archive")
}

// pt-BR (#93.1 — RBAC, 2026-10-16): Profile é o agregado de "papéis"
// no sentido de RBAC. Cada Profile agrupa N Authorizations (permissões).
// O flag `isAdmin` é o bypass total: mesmo que o perfil "admin" perca
// todas as Authorizations, o guard continua deixando passar via
// `permissionsGuard.isAdmin = true`. Defesa em profundidade.
//
// `isSystem` impede deletar o perfil — perfis de sistema são gerenciados
// só pelo seed/migrations. Sem isso, um admin distraído poderia deletar
// "admin" e perder acesso a si próprio (lock-out).
//
// Profile NÃO tem soft-delete: é config de admin, não dado de negócio.
// Hard delete com proteção via `countUsersWithProfile` (FK onDelete:
// Restrict + check explícito antes). Perfis de sistema (isSystem=true)
// são protegidos no agregado (`marcarExcluido` lança).
model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  // Slug canônico: 'admin', 'manager', 'viewer'. Kebab-case, imutável após
  // criação (renomear quebraria referências em audit logs). O `name` é o
  // rótulo editável.
  //
  // pt-BR (Fase 2 — tenancy, 2026-10-16): perdeu o `@unique`. A unicidade
  // agora vem de DOIS índices parciais em SQL puro (migration
  // `20261017000000_tenant_membership_invitation`), porque a D3 exige que
  // duas empresas tenham ambas um perfil "manager" e que o "admin" global
  // continue único. `@@unique([tenantId, slug])` não serviria: no Postgres
  // NULL != NULL, então o seed duplicaria "admin" em silêncio.
  slug        String
  name        String
  description String?
  // NULL = perfil global (compartilhado por todas as empresas, é o caso do
  // seed do #97). Preenchido = perfil customizado de UMA empresa.
  tenantId    String?  @map("tenant_id") @db.Uuid
  // Bypass total: o guard dá true sem consultar Authorizations.
  isAdmin     Boolean  @default(false) @map("is_admin")
  // Perfil de sistema: protegido contra DELETE via use case.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  version     Int      @default(1)

  tenant         Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorizations Authorization[]
  users          User[]
  // pt-BR (Fase 4 — tenancy, 2026-10-16): quem veste este perfil, POR
  // EMPRESA. É a direção inversa de `users` (que é o bucket global).
  memberships    TenantMembership[]

  @@index([slug])
  @@index([tenantId])
  @@map("profiles")
}

// pt-BR (#93.1 — RBAC, 2026-10-16): Authorization é a relação "perfil
// TEM permissão X". A chave única `(profile_id, permission_key)` impede
// duplicar a mesma permissão no mesmo perfil. O `permission_key` é uma
// string hierárquica com pontos: 'users.read', 'users.write',
// 'admin.manage_profiles', 'reports.view'.
//
// O guard usa a chave exata; permissões não são hierárquicas (ter
// 'admin.*' não implica 'users.read'). O catálogo de chaves vive em
// `permissions.catalog.ts` e é validado no seed/import.
model Authorization {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  version       Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([profileId, permissionKey])
  @@index([profileId])
  @@index([permissionKey])
  @@map("authorizations")
}

// pt-BR (Fase 2 — tenancy, 2026-10-16): a empresa. `slug` é GLOBAL entre
// empresas (é o identificador de URL), enquanto o slug de PERFIL é por tenant
// (D3) — são dois escopos diferentes e por isso dois `@unique` diferentes.
//
// Sem soft-delete: apagar uma empresa é raro e o efeito (cascatear perfis,
// memberships e convites) é destrutivo demais para `deletedAt` silencioso.
model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  profiles    Profile[]
  memberships TenantMembership[]
  invitations Invitation[]

  @@map("tenants")
}

// pt-BR (Fase 2 — tenancy, 2026-10-16): a identidade do usuário NA empresa.
// É esta tabela que faz "1 conta, N empresas" (D4) ser verdade: o login
// resolve por `users.email` (global) e o tenant entra depois, por header.
//
// `role` é o rótulo de tenant ('owner' | 'member') e NÃO substitui o RBAC: a
// autorização fina continua em `profiles.authorizations`. Aqui é só "quem
// pode administrar a empresa".
//
// pt-BR (Fase 4 — tenancy, 2026-10-16): `profileId` é o elo que faltava na
// D4 — QUAL perfil este usuário veste NESTA empresa. Sem ele, "perfil
// diferente por empresa" não é representável, porque a única leitura possível
// era `users.profile_id`, que é global. `null` = membership sem perfil
// atribuído (convite aceito, aguardando o admin da empresa), e resolve para
// zero permissões — não para perfil de sistema.
model TenantMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  role      String   @default("member")
  profileId String?  @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // `Restrict` como `users.profileId`: o admin reatribui antes de deletar.
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // A D4 inteira: uma conta pode estar em N empresas, mas só UMA vez em cada.
  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([profileId])
  @@map("tenant_memberships")
}

// pt-BR (Fase 2 — tenancy, 2026-10-16): a D5 — "empresa própria OU convite".
// Um convite é POR EMAIL e por tenant: quem aceita precisa existir (ou criar
// conta) e precisa estar autenticado, então o aceite acontece na Fase 4.
model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  role       String    @default("member")
  // pt-BR (Fase 5 — tenancy, 2026-10-16): o segredo do convite. Sem ele,
  // `POST /invitations/accept` seria "entre na empresa X": o id da empresa
  // é um UUID que não se enumera, mas o de uma empresa da qual a pessoa já
  // saiu continua no histórico dela — e aí o furo é real. O token é o que
  // prova que o convite foi emitido. Sem mailer no repo, o token volta na
  // resposta do produtor (`POST /tenants/:id/invitations`).
  token      String    @unique @map("token")
  // NULL = pendente. Preenchido = já consumida (aceite). Não há `revokedAt`
  // nesta fase: revogar é um DELETE, e o histórico de convite não é dado
  // regulado aqui.
  acceptedAt DateTime? @map("accepted_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  version    Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("invitations")
}

// pt-BR (feature-flags, 2026-10-18 — decisão D1): o estado das functionalities
// que o administrador do sistema liga e desliga.
//
// SEM `tenant_id`, de propósito: a flag não é por empresa. Ela responde "esta
// funcionalidade está disponível no sistema inteiro?", e a resposta é a mesma
// para todo ator. Uma coluna de empresa aqui seria uma mentira estrutural — o
// isolamento por empresa que a RLS garante em `profiles`/`users` não tem o que
// filtrar.
//
// `chave` é a PRIMARY KEY e não um `id` uuid: a chave JÁ é o identificador
// (é o que o `@RequireFeatureFlag('tenancy.invites')` traz), e uma segunda
// coluna de identidade só criaria duas maneiras de dizer a mesma coisa.
//
// ⚠️ A LINHA AUSENTE SIGNIFICA ATIVADA (D4). A tabela guarda só as exceções —
// quem está desligada. Por isso o `DEFAULT true` aqui é documentação, não o
// mecanismo: quem decide na leitura é o repositório, que devolve `true` para
// chave que não encontrou. Chave nova no catálogo não apaga nada.
model FeatureFlag {
  chave     String   @id
  ativada   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(1)

  @@map("feature_flags")
}
