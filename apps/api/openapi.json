    "/api/v1/users/{id}": {
      "get": {
        "operationId": "UsersController_findOne",
        "parameters": [],
        "responses": {
          "200": {
            "description": "User encontrado"
          },
          "403": {
            "description": "O `:id` da rota não é o `sub` do token (USER_OWNERSHIP_VIOLATION)"
          },
          "404": {
            "description": "User não encontrado"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Buscar usuário por ID",
        "tags": ["users"]
      },
      "patch": {
        "operationId": "UsersController_update",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "description": "ETag esperado no formato W/\"v<n>\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User renomeado"
          },
          "400": {
            "description": "Header If-Match ausente ou inválido"
          },
          "403": {
            "description": "O `:id` da rota não é o `sub` do token (USER_OWNERSHIP_VIOLATION)"
          },
          "404": {
            "description": "User não encontrado"
          },
          "412": {
            "description": "Conflito de versão (optimistic lock)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Renomear usuário (optimistic locking via If-Match)",
        "tags": ["users"]
      },
      "delete": {
        "operationId": "UsersController_remove",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User soft-deletado"
          },
          "400": {
            "description": "Header If-Match ausente ou inválido"
          },
          "403": {
            "description": "O `:id` da rota não é o `sub` do token (USER_OWNERSHIP_VIOLATION)"
          },
          "404": {
            "description": "User não encontrado"
          },
          "412": {
            "description": "Conflito de versão"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Soft-delete do usuário (optimistic locking via If-Match)",
        "tags": ["users"]
      }
    },
