    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Sessão emitida",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "accessToken": "eyJhbGciOi…",
                    "refreshToken": "eyJhbGciOi…",
                    "user": {
                      "id": "0190a8b6-…",
                      "nome": "João",
                      "email": "joao@example.com"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Credenciais inválidas"
          },
          "429": {
            "description": "Limite de tentativas por conta (`ip:email`) excedido"
          }
        },
        "summary": "Autenticar e emitir sessão",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Par de tokens renovado"
          },
          "400": {
            "description": "Payload inválido"
          },
          "401": {
            "description": "Refresh token ausente, expirado ou inválido"
          }
        },
        "summary": "Renovar a sessão a partir do refresh token",
        "tags": ["auth"]
      }
    },
