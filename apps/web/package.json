{
  "name": "@projeto/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test:unit": "vitest run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "clean": "rm -rf .next .next-e2e .turbo"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/auto-instrumentations-web": "^0.43.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.2",
    "@opentelemetry/instrumentation-document-load": "^0.43.0",
    "@opentelemetry/instrumentation-fetch": "^0.54.2",
    "@opentelemetry/instrumentation-user-interaction": "^0.43.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.54.2",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-web": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@projeto/shared-types": "workspace:*",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "web-vitals": "^4.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@projeto/eslint-config": "workspace:*",
    "@projeto/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
