# apps/web/.env.example
API_BASE_URL=http://localhost:3000/api/v1
# ============================================================================
# OpenTelemetry — Frontend (apps/web)
# ============================================================================
# Server-side telemetry (apps/web/instrumentation.node.ts) usa vars OTEL_*
# sem prefixo — lidas via process.env em runtime Node (RSC, API routes,
# server actions).
#
# Browser-side telemetry (apps/web/instrumentation-client.ts) EXIGE prefixo
# NEXT_PUBLIC_* — Next.js só inline-a essas vars no bundle browser em build
# time; sem prefixo, o valor fica `undefined` no client (o código tem
# fallback hardcoded, mas a config nunca chega ao bundle).
#
# IMPORTANTE: mantenha os pares OTEL_* e NEXT_PUBLIC_OTEL_* em sincronia
# sempre que alterar valores de runtime do frontend. Os code defaults já
# convergem em `http://otel-collector:4318/v1/traces` para server-side e
# `/api/otel/collect` para browser-side.

# --- Server-side (apps/web/instrumentation.node.ts → NodeSDK + OTLPTraceExporter HTTP) ---
# Endpoint HTTP OTLP — apps/web/instrumentation.node.ts cria explicitamente
# um OTLPTraceExporter (HTTP, não gRPC), então porta 4318 + path /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Browser-side (apps/web/instrumentation-client.ts → WebTracerProvider + OTLPTraceExporter HTTP) ---
# Em dev: browser fala direto com o collector rodando em localhost
# (porta OTLP HTTP 4318, path /v1/traces).
# Em prod: sobrescreva para `/api/otel/collect` (proxy Next.js CORS-friendly
# que repassa para o collector interno; ver plano §3.2).
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
NEXT_PUBLIC_OTEL_SERVICE_NAME=projeto-base-web
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Sinais (compartilhados server + browser) ---
# Para web-vitals, métricas são sempre ON.
OTEL_METRICS_EXPORTER=otlp
# Traces do browser (fetch/xhr/document-load) também ON.
OTEL_TRACES_EXPORTER=otlp